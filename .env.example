# Copy this file to .env, replace the values, and source it before running Java.
# .env is ignored by Git, so do not commit the real password.
HM_DB_URL="jdbc:mariadb://localhost:3306/hackmatch?sslMode=disable"
HM_DB_USER="hackmatch_app"
HM_DB_PASSWORD="replace-with-your-local-password"
HM_PORT="8080"
